# --------------------------------------------------
# Development Stage with Hot-Reload for Docker
# --------------------------------------------------
FROM node:22-alpine

WORKDIR /app

# Copy dependency manifests
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm install

# Copy application files
COPY . .

# Expose Vite development server port
EXPOSE 5173

# Start Vite dev server (host 0.0.0.0 is configured in vite.config.ts)
CMD ["npm", "run", "dev"]
